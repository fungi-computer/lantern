{
  "name": "@fungi.computer/lantern",
  "version": "0.3.0",
  "author": "Levi <levi@technomancy.dev>",
  "description": "Shared Fungi terminal wordmarks, Clack interaction and progress",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./banner": {
      "types": "./dist/banner.d.ts",
      "import": "./dist/banner.js"
    }
  },
  "files": [
    "dist",
    "docs/api",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "lint": "eslint src test scripts --max-warnings=0 && ../../node_modules/.bin/oxlint --config ../../oxlint.config.ts --deny-warnings src test scripts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "clean": "node --input-type=module --eval \"import { rm } from 'node:fs/promises'; await rm('dist', { recursive: true, force: true });\"",
    "test": "vitest run",
    "docs": "tsx ../../tooling/repository/src/docs/cli.ts check --root ../..",
    "docs:write": "tsx ../../tooling/repository/src/docs/cli.ts write --root ../..",
    "pack": "mkdir -p ../../.botanical/lantern-pack && pnpm pack --pack-destination ../../.botanical/lantern-pack",
    "smoke": "node --input-type=module -e \"import('./dist/index.js').then(({Cli}) => { if (typeof Cli !== 'function') process.exit(1); })\"",
    "stranger": "tsx ../../tooling/repository/src/artifacts/cli.ts --repo-root ../.. .",
    "format:check": "node ../../tooling/repository/scripts/format-package-check.mjs",
    "lint:anti-slop": "node ../../tooling/repository/scripts/lint-package-anti-slop.mjs",
    "prepack": "node scripts/prepare-package.mjs"
  },
  "dependencies": {
    "@clack/core": "1.4.3",
    "@clack/prompts": "1.7.0",
    "@fungi.computer/stipe": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "botanical": {
    "role": "package",
    "operations": {
      "lint": "required",
      "typecheck": "required",
      "build": "required",
      "test": "required",
      "docs": "required",
      "pack": "required",
      "smoke": "required",
      "stranger": "required"
    }
  },
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "directory": ".botanical/package",
    "linkDirectory": false
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fungi-computer/lantern.git"
  }
}
